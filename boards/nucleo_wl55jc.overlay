#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    leds {
        compatible = "gpio-leds";

        led_1: led_1 {
            gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
        };

        led_2: led_2 {
            gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
        };

        led_3: led_3 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        };
    };
};